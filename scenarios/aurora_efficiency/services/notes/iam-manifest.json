{
  "schema_version": 1,
  "resource": "notes",
  "operations": {
    "describe": {"public": true},
    "health": {"public": true},
    "list_notes": {"permission": "read", "requestable": true},
    "read_note": {"permission": "read", "requestable": true, "target": "key"},
    "write_note": {"permission": "write", "requestable": true, "target": "key"},
    "delete_note": {"permission": "write", "requestable": true, "target": "key"},
    "list_grants": {"authenticated": true},
    "grant_rights": {"authenticated": true},
    "revoke_rights": {"authenticated": true},
    "submit_request": {"authenticated": true},
    "list_requests": {"authenticated": true},
    "decide_request": {"authenticated": true, "target": "request_id"}
  },
  "http": {
    "GET /": "describe",
    "GET /health": "health",
    "GET /notes": "list_notes",
    "GET /notes/{key}": "read_note",
    "PUT /notes/{key}": "write_note",
    "DELETE /notes/{key}": "delete_note",
    "GET /grants": "list_grants",
    "POST /grants": "grant_rights",
    "DELETE /grants": "revoke_rights",
    "POST /requests": "submit_request",
    "GET /requests": "list_requests",
    "POST /requests/{request_id}/decision": "decide_request"
  }
}
